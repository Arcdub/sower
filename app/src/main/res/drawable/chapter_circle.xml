<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable chapter circle: white fill (light) / dark tile (night) with a thin gold ring. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/bubbleRipple">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/book_tile" />
            <stroke
                android:width="1dp"
                android:color="@color/sower_gold" />
        </shape>
    </item>
</ripple>
