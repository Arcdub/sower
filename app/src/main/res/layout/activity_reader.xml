<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg"
        app:navigationIconTint="?attr/colorOnPrimary"
        app:titleTextColor="?attr/colorOnPrimary">

        <!-- Same gold as the home FAB: the share action travels with the reader. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/toolbarPassButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:contentDescription="@string/menu_pass_it_on"
            app:backgroundTint="@color/sower_gold"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/sower_ink" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- One TextView per chapter so native text selection can flow across verses. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/verseScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <!-- Selection tints match the committed highlight, so a press-drag
             highlight looks live under the finger and commits with no flash. -->
        <arcsky.steph.sower.HighlightTextView
            android:id="@+id/chapterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.35"
            android:textIsSelectable="true"
            android:textColorHighlight="#59C8A24B"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
    </androidx.core.widget.NestedScrollView>

    <RelativeLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/prevChapter"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/previous_chapter" />

        <TextView
            android:id="@+id/chapterLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextChapter"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="@string/next_chapter" />
    </RelativeLayout>

</LinearLayout>
