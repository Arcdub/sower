<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar_bg"
        app:navigationIconTint="?attr/colorOnPrimary">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@android:color/transparent"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/colorOnPrimary"
            android:textColorHint="#B3FFFFFF" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Visible while a search runs, so quiet moments read as working, not empty. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/searchProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/sower_gold"
        app:trackColor="@color/chip_selected" />

    <TextView
        android:id="@+id/searchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:alpha="0.7"
        android:text="@string/search_prompt" />

    <com.google.android.material.chip.Chip
        android:id="@+id/highlightsChip"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:checkable="true"
        android:text="@string/chip_highlights_only"
        android:textColor="@color/book_text"
        app:chipBackgroundColor="@color/chip_bg"
        app:chipIcon="@drawable/ic_star"
        app:chipIconTint="@color/sower_gold"
        app:chipStrokeColor="@color/sower_gold"
        app:chipStrokeWidth="1dp"
        app:checkedIconTint="@color/book_text" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

</LinearLayout>
