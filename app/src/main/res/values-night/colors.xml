    <color name="book_tile_border">#314038</color>
    <color name="book_text">#E8E0CF</color>
    <color name="book_icon">#C8A24B</color>
    <color name="chapter_ring">#7A6534</color>
    <color name="filled_button_bg">#8CBF94</color>
    <color name="filled_button_text">#10241A</color>
