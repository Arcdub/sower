<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night reading palette: deep green-charcoal page, cream text, gold accents. -->
    <style name="Base.Theme.Sower" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#8CBF94</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#223328</item>
        <item name="colorOnPrimaryContainer">@color/book_text</item>
        <item name="colorSecondary">@color/sower_gold</item>

        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="colorSurface">@color/page_bg</item>
        <item name="colorOnSurface">@color/book_text</item>
        <item name="colorOnSurfaceVariant">#B7C4B8</item>
        <item name="colorOutline">@color/book_tile_border</item>

        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- The verse of the day is the one card gold outlines. -->
        <item name="bubbleBackground">#223328</item>
        <item name="bubbleText">@color/book_text</item>
        <item name="bubbleRipple">#C8A24B</item>
        <item name="sectionHeading">#C8A24B</item>
    </style>
</resources>
