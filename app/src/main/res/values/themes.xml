<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Sower" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sower_green</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#D8E8D4</item>
        <item name="colorOnPrimaryContainer">@color/sower_green_dark</item>
        <item name="colorSecondary">@color/sower_gold</item>
        <!-- Warm cream canvas so white book tiles read as cards. -->
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="colorSurface">@color/page_bg</item>
        <!-- Transparent bar: the toolbar's green extends underneath it (see EdgeToEdge). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- Default (green) reading surfaces. -->
        <item name="bubbleBackground">@color/book_bubble</item>
        <item name="bubbleText">@color/sower_green_dark</item>
        <item name="bubbleRipple">@color/sower_green</item>
        <item name="sectionHeading">@color/sower_green</item>
    </style>

    <style name="Theme.Sower" parent="Base.Theme.Sower" />
</resources>
